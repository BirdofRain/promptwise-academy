# =============================================================================
# PromptWise Academy — environment variables
# Copy to .env.local for local dev. Set in Vercel → Project → Settings → Environment Variables for deploy.
# Never commit .env, .env.local, or real secrets.
# =============================================================================

# App (required in production — use your canonical URL, no trailing slash)
APP_URL=http://localhost:3000

# Auth — see docs/AUTH.md
# mock  = cookie dev login, no database (local UI only)
# authjs = Auth.js + Prisma (staging and production beta)
AUTH_MODE=mock

# Required when AUTH_MODE=authjs (generate: openssl rand -base64 32)
AUTH_SECRET=

# Auth.js uses APP_URL for callbacks when trustHost is enabled (auth.ts).
# On Vercel, set APP_URL to https://your-production-domain.vercel.app

# Database (required when AUTH_MODE=authjs)
# Neon: https://neon.tech | Supabase: Project Settings → Database → connection string
DATABASE_URL=postgresql://user:password@host:5432/promptwise?sslmode=require

# Stripe (required for real checkout; routes return 503 if missing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...

# OpenAI (optional — Master Prompt Builder falls back to templates without this)
OPENAI_API_KEY=sk-...

# Node environment (Vercel sets automatically — do not override unless you know why)
# NODE_ENV=production
