# =============================================================================
# PromptWise Academy — environment variables
# Copy to .env.local and fill in values.
# =============================================================================

# App
APP_URL=http://localhost:3000

# Auth — see docs/AUTH.md
# mock = cookie dev login (no database)
# authjs = Auth.js + Prisma (production beta)
AUTH_MODE=mock
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Database (required when AUTH_MODE=authjs)
# Neon: https://neon.tech — Supabase: use Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/promptwise?sslmode=require

# Stripe (optional until you enable payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...

# OpenAI (optional — Master Prompt Builder uses template fallback without it)
OPENAI_API_KEY=sk-...
